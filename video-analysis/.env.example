# Copy to .env and fill in a real value - no code default, matches the Kotlin server's
# app.video-analysis.api-key / app.jwt.secret "secrets have no code default" convention.
API_KEY=replace-with-a-real-shared-secret

YOLO_MODEL_PATH=yolov8n.pt
FRAME_STRIDE=3
MIN_DETECTION_CONFIDENCE=0.4
PLATE_CONFIDENCE_FLOOR=0.3
